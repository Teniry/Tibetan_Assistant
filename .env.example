# 后端端口（生产环境前端与 API 共用此端口）
PORT=3001

# 阿里云百炼 API Key（可选）
# 不填写时系统仍可使用 4,641 条本地知识库进行离线回答。
ALIYUN_API_KEY=

# 统一使用 DeepSeek-V3。服务端会忽略旧会话中保存的其他模型名称。
ALIYUN_MODEL=deepseek-v3

# RAGFlow HTTP API 地址。与本项目在同一台 AutoDL 实例时优先填本机地址，
# 常见值为 http://127.0.0.1:9380；请以 docker ps 显示的实际端口为准。
RAGFLOW_BASE_URL=

# 在 RAGFlow 右上角头像 -> API 中创建。不要提交到代码仓库或截图。
RAGFLOW_API_KEY=

# 导入和运行时都可按名称寻找知识库；默认使用 muya。
RAGFLOW_DATASET_NAME=muya

# 可选：直接指定知识库 ID（多个 ID 用英文逗号分隔）；留空时按上面的名称动态解析。
RAGFLOW_DATASET_IDS=

# 低于阈值的片段会被丢弃；建议先从 0.35 开始，用测试接口观察后微调。
RAGFLOW_SIMILARITY_THRESHOLD=0.35
RAGFLOW_VECTOR_SIMILARITY_WEIGHT=0.30
RAGFLOW_PAGE_SIZE=8
RAGFLOW_TOP_K=64
RAGFLOW_TIMEOUT_MS=20000

# RAGFlow 暂时不可用时，是否使用部署包自带的 4,641 条本地词库兜底。
# 兜底仍是知识库回答，不会开放 AI 常识回答。
RAGFLOW_FALLBACK_LOCAL=true

# 木小知在 RAGFlow 零命中时使用的可信联网检索（也可在 /config 高级配置中填写）。
# 申请地址：https://app.tavily.com/
TAVILY_API_KEY=

# cpolar Authtoken 不要写在本文件或上传到服务器。
# 请在目标机器上单独执行：cpolar authtoken <你的令牌>
