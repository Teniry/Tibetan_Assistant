      "carouselImages": [
        {
          "id": "car_muya_dist",
          "imageUrl": "/uploads/resources/1786942032081_vw0v0c.jpg",
          "title": "木雅分布区域",
          "description": "木雅人主要分布在四川省甘孜藏族自治州康定市折多山以西、雅砻江以东、道孚县以南、九龙县以北的地区，藏文史籍称这一区域为「木雅热岗」，居住在此的藏族被称为「木雅娃」。木雅语分为东部方言（自称「木勒」，分布于九龙县湾坝、洪坝一带及石棉县部分地区）和西部方言（自称「木雅」，分布于九龙县汤古乡，康定市沙德、六巴、普沙绒、朋布西乡和雅江县祝桑乡）。木雅人大致围绕贡嘎山分布，贡嘎山因此被视为木雅人的圣山。",
          "sourceUrl": "https://www.gzz.gov.cn/mfms/article/72457",
          "sourceName": "甘孜州人民政府网《木雅文化》"
        },
        {
          "id": "car_muya_gongga",
          "imageUrl": "/uploads/resources/1786942036018_o5jabf.webp",
          "title": "贡嘎山——木雅圣山",
          "description": "贡嘎山海拔7556米，坐落于青藏高原东部边缘，位于康定市、泸定县分界处，是横断山脉大雪山的主峰、四川省第一高峰，被誉为「蜀山之王」。贡嘎山在木雅地区被称为「木雅贡嘎」，是木雅人的圣山。贡嘎山是中国冰川最发达的山峰之一，海螺沟冰川长30公里，是世界罕见的低海拔冰川。",
          "sourceUrl": "https://www.kangding.gov.cn/kdcsjs/article/107034",
          "sourceName": "康定市人民政府网《城市建设》栏目"
        },
        {
          "id": "car_muya_jinta",
          "imageUrl": "/uploads/resources/1786942039917_lfyq5z.webp",
          "title": "木雅金塔（木雅尊胜塔）",
          "description": "木雅金塔又名「木雅尊胜塔」，位于康定市新都桥镇塔公乡境内，是多吉扎西活佛为纪念十世班禅大师于此灌顶布法而修建的佛塔，为坛城式佛教寺庙建筑。金塔位于雅拉神山、夏古冬青山、文殊山、观音山等八座神山所环绕的中心，藏语称「古汝塘」，意为「莲师道场」。",
          "sourceUrl": "https://www.kangding.gov.cn/kdcsjs/article/107034",
          "sourceName": "康定市人民政府网《城市建设》栏目"
        },
        {
          "id": "car_muya_guzhuang",
          "imageUrl": "/uploads/resources/1786942127566_2yshxh.webp",
          "title": "木雅锅庄——国家级非遗",
          "description": "木雅锅庄是木雅人最具特色的舞蹈，已列入国家级非物质文化遗产。木雅人在农闲时节聚在一起祈年祷岁、歌舞娱乐，所唱跳的舞蹈便是木雅锅庄。有趣的是，锅庄的吟唱辞令全部使用康巴藏语，与木雅人平日劳作生活使用的木雅语大相径庭。在木雅圣地景区的锅庄广场上，常有身着传统服饰的村民演绎，游客可参与其中。",
          "sourceUrl": "https://youletour.com/ganzizhou/mu-ya-sheng-di",
          "sourceName": "游乐旅行网《木雅圣地景区》"
        },
        {
          "id": "car_muya_diao",
          "imageUrl": "/uploads/resources/1786942186999_kuopio.jpeg",
          "title": "朋布西双碉——木雅古碉楼",
          "description": "木雅地区是高碉文化十分发育的地区，建筑以石木结构藏房为主。今存于康定市朋布西乡和沙德乡一带的高碉，数量仅次于丹巴县的高碉。其中「朋布西双碉」（木雅双子塔）经测定有800年以上历史，是木雅地区高碉文化的代表。",
          "sourceUrl": "https://baike.baidu.com/item/%E6%9C%A8%E9%9B%85%E4%B9%8B%E5%9C%B0/23072001",
          "sourceName": "百度百科《木雅之地》"
        }
      ],
